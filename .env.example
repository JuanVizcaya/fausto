# Copy to .env (git-ignored) and fill in.

# The database's password; compose builds fausto's connection string from it.
FAUSTO_MONGO_PASSWORD=change-me          # e.g. `openssl rand -hex 24`
# FAUSTO_MONGO_DB=fausto

# The absolute path of the directory holding local clones of your projects.
# The container sees it at the same path, so register clones by their path on
# your machine.
FAUSTO_PROJECTS_DIR=/home/you/src

# For projects on GitHub: a fine-grained token with contents and pull
# requests (read and write) on their repositories.
# FAUSTO_GITHUB_TOKEN=
# Hand each checked pull request to the project's workflows (project checks,
# reviewers): see "Handing pull requests to the project's workflows" in
# README.md. Needs contents (read and write) on the token.
# FAUSTO_PR_HANDOFF=true
# How often to check accepted proposals for a merge (default 1m).
# FAUSTO_POLL=1m

# Identity for proposal commits; without it (and without git's) fausto is read-only.
# FAUSTO_AUTHOR="Your Name <you@example.com>"
# FAUSTO_BASE=main
FAUSTO_PORT=7070
# Match your user so files fausto writes are yours (run `id -u` / `id -g`).
FAUSTO_UID=1000
FAUSTO_GID=1000

# Running fausto from source against the dev database (compose.dev.yaml):
# FAUSTO_MONGO_URI=mongodb://fausto:change-me@localhost:27017/?authSource=admin
# FAUSTO_MONGO_PORT=27017

# Optional: mirror tasks as Jira Cloud issues (see README).
# FAUSTO_JIRA_URL=https://your-site.atlassian.net
# FAUSTO_JIRA_EMAIL=you@example.com
# FAUSTO_JIRA_TOKEN=                   # https://id.atlassian.com/manage-profile/security/api-tokens
# FAUSTO_JIRA_PROJECT=FAUS
# FAUSTO_JIRA_ISSUE_TYPE=Task
# FAUSTO_JIRA_STATUSES="open=To Do,in-progress=In Progress,done=Done,dropped=Done"
