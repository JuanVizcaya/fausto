HTTP_PORT=8080
RESIDENTS_DB_PASSWORD=residents
ADMINISTRATORS_DB_PASSWORD=administrators

# Fausto (docker compose --profile fausto up fausto)
# Required to edit: without it fausto is read-only.
# FAUSTO_AUTHOR="Your Name <you@example.com>"
FAUSTO_PORT=7070
# Match your user so files fausto writes are yours (run `id -u` / `id -g`).
FAUSTO_UID=1000
FAUSTO_GID=1000

# Fausto's database for proposals and tasks; without it fausto is read-only.
# Start it with: docker compose -f fausto/compose.yaml --env-file .env up -d
# FAUSTO_MONGO_PASSWORD=change-me      # e.g. `openssl rand -hex 24`
# FAUSTO_MONGO_URI=mongodb://fausto:change-me@localhost:27017/?authSource=admin
# FAUSTO_MONGO_DB=fausto
# FAUSTO_MONGO_PORT=27017
# The fausto container reaches the host's database through host.docker.internal
# by default; set this instead for a shared database elsewhere.
# FAUSTO_CONTAINER_MONGO_URI=mongodb://fausto:...@db.example.com:27017/?authSource=admin

# Optional: mirror tasks as Jira Cloud issues (see fausto/README.md).
# FAUSTO_JIRA_URL=https://your-site.atlassian.net
# FAUSTO_JIRA_EMAIL=you@example.com
# FAUSTO_JIRA_TOKEN=                   # https://id.atlassian.com/manage-profile/security/api-tokens
# FAUSTO_JIRA_PROJECT=FAUS
# FAUSTO_JIRA_ISSUE_TYPE=Task
# FAUSTO_JIRA_STATUSES="open=To Do,in-progress=In Progress,done=Done,dropped=Done"
