{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision.schema.json",
  "title": "Architecture decision record (front matter)",
  "type": "object",
  "required": ["id", "title", "status", "date"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{4}$"},
    "title": {"type": "string"},
    "status": {"enum": ["proposed", "accepted", "superseded", "rejected"]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "supersedes": {"type": "string", "pattern": "^[0-9]{4}$"},
    "affects": {"type": "array", "items": {"type": "string"}}
  }
}
