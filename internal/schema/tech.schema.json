{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tech.schema.json",
  "title": "Technology radar",
  "type": "object",
  "required": ["technologies"],
  "additionalProperties": false,
  "properties": {
    "technologies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string"},
          "category": {"enum": ["language", "framework", "library", "protocol", "datastore", "infrastructure"]},
          "status": {"enum": ["adopt", "trial", "assess", "hold"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
