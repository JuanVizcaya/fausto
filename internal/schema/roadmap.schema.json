{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roadmap.schema.json",
  "title": "Roadmap",
  "type": "object",
  "required": ["milestones"],
  "additionalProperties": false,
  "properties": {
    "milestones": {
      "type": "array",
      "description": "Milestones in roadmap order.",
      "items": {
        "type": "object",
        "required": ["id", "title", "goal", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1, "description": "The outcome, in terms of what users or the system can do."},
          "status": {"enum": ["planned", "in-progress", "done", "dropped"]},
          "target": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2]|Q[1-4])$",
            "description": "Target month (2026-12) or quarter (2026-Q4)."
          },
          "depends_on": {"type": "array", "items": {"type": "string"}, "description": "Milestones that must be done first."},
          "components": {"type": "array", "items": {"type": "string"}, "description": "Components this milestone changes."},
          "decisions": {"type": "array", "items": {"type": "string"}, "description": "Related decision ids."},
          "exit_criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text"],
              "additionalProperties": false,
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "done": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
