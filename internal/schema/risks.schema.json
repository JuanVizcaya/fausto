{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risks.schema.json",
  "title": "Risk register",
  "type": "object",
  "required": ["risks"],
  "additionalProperties": false,
  "properties": {
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "category", "likelihood", "impact", "status", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1, "description": "What could happen and what it would cost."},
          "category": {"enum": ["security", "technical", "operational", "delivery", "compliance"]},
          "likelihood": {"enum": ["low", "medium", "high"]},
          "impact": {"enum": ["low", "medium", "high"]},
          "status": {"enum": ["open", "mitigating", "accepted", "closed"], "description": "accepted: knowingly living with it. closed: no longer a risk."},
          "owner": {"type": "string", "description": "Agent id responsible for it."},
          "mitigation": {"type": "string", "description": "What reduces it. Required when likelihood × impact is 6 or more."},
          "review_by": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$", "description": "Month to revisit it (2026-12)."},
          "components": {"type": "array", "items": {"type": "string"}},
          "milestones": {"type": "array", "items": {"type": "string"}},
          "requirements": {"type": "array", "items": {"type": "string"}},
          "decisions": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
