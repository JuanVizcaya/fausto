{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent.schema.json",
  "title": "Agent charter",
  "type": "object",
  "required": ["id", "name", "kind", "scope", "owns"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "name": {"type": "string"},
    "kind": {"enum": ["agent", "human"]},
    "scope": {"type": "string"},
    "owns": {
      "type": "array",
      "minItems": 1,
      "description": "Files, or directories ending in /. The most specific entry across all agents owns a file.",
      "items": {"type": "string", "minLength": 1}
    },
    "rules": {"type": "array", "items": {"type": "string"}},
    "reviewers": {
      "type": "array",
      "description": "GitHub users (@name) or teams (@org/team) who review changes to the owned paths; fausto writes them to .github/CODEOWNERS. Without any, a charter's paths go to the reviewers of every human charter.",
      "items": {"type": "string", "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:/[A-Za-z0-9._-]+)?$"},
      "uniqueItems": true
    }
  }
}
